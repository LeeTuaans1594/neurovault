# ══════════════════════════════════════════════
# NEUROVAULT — Environment Configuration Template
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════

# ── Server ──
PORT=5001
NODE_ENV=development

# ── MongoDB ──
# Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=<app>
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/neurovault?appName=NeuroVault

# ── JWT (PHẢI thay đổi trong production!) ──
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── File Upload ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ── AI Core (Python FastAPI) ──
AI_CORE_URL=http://127.0.0.1:8000

# ── Google OAuth 2.0 (Optional — không bắt buộc) ──
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ── Frontend URL ──
CLIENT_URL=http://localhost:5173

# ── Ollama (Local LLM) ──
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b
